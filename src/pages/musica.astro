---
import Base from '../layouts/Base.astro';
import { crew } from '../data/crew';
---

<Base title="La Cabina" description="Las cinco playlists de la pandilla de Duck Vandal, en casetes.">
  <div class="page-head">
    <a class="return-link" href="/">← Volver al callejón</a>
    <h2>La Cabina</h2>
  </div>

  <section class="cabina-console" id="cabina" aria-label="Reproductor">
    <div class="cabina-deck" aria-hidden="true"><div id="cabina-loaded" hidden></div></div>
    <div class="cabina-display">
      <p id="cabina-prompt">Elige un casete de la pandilla.</p>
      <div id="cabina-track" hidden>
        <img id="cabina-portrait" width="96" height="96" alt="" />
        <div role="status">
          <h3 id="cabina-name"></h3>
          <p id="cabina-quote"></p>
          <a id="cabina-spotify" class="spotify" target="_blank" rel="noopener">Abrir en Spotify ↗</a>
        </div>
      </div>
    </div>
  </section>

  <div class="cabina-rack" role="group" aria-label="Casetes de la pandilla">
    {crew.map((d) => (
      <button
        class="cabina-cassette"
        type="button"
        data-id={d.id}
        aria-pressed="false"
        aria-controls="cabina-track"
        style={`--accent:${d.accent}`}
      >
        <span class="cassette-label">
          <img src={d.mini} width="48" height="48" alt="" loading="lazy" />
          <strong>{d.name}</strong>
        </span>
      </button>
    ))}
  </div>

  <script define:vars={{ crew }}>
    const $ = (id) => document.getElementById(id);
    const root = $('cabina');
    document.querySelectorAll('.cabina-cassette').forEach((btn) => {
      btn.addEventListener('click', () => {
        const d = crew.find((c) => c.id === btn.dataset.id);
        document.querySelector('.cabina-cassette[aria-pressed=true]')?.setAttribute('aria-pressed', 'false');
        btn.setAttribute('aria-pressed', 'true');
        root.style.setProperty('--accent', d.accent);
        const loaded = $('cabina-loaded');
        loaded.innerHTML = `<span class="cassette-label" style="--accent:${d.accent}"><img src="${d.mini}" width="48" height="48" alt=""><strong>${d.name}</strong></span>`;
        loaded.hidden = false;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          loaded.animate(
            [{ transform: 'translateY(-65%) scale(1.15)', opacity: 0 }, { transform: 'none', opacity: 1 }],
            { duration: 310, easing: 'cubic-bezier(.16,1,.3,1)' }
          );
        }
        $('cabina-prompt').hidden = true;
        $('cabina-track').hidden = false;
        $('cabina-portrait').src = d.mini;
        $('cabina-name').textContent = d.name;
        $('cabina-quote').textContent = `«${d.cabinaLine}»`;
        const link = $('cabina-spotify');
        link.href = d.spotify;
        link.setAttribute('aria-label', `Abrir la playlist de ${d.name} en Spotify`);
      });
    });
  </script>
</Base>
